# Copy this file to `.env` and fill in real values.
# IMPORTANT: Secrets must NEVER be prefixed with VITE_ — Vite bundles
# anything starting with VITE_ into the client bundle and exposes it publicly.
# Keep API keys (e.g. Gemini) server-side only (process.env on the Express API).

# Server-side only (used by Express API, never exposed to the browser)
GEMINI_API_KEY=
